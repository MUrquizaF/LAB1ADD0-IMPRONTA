SELECT

      dt.id_dte

    , dt.numero_control

    , dt.codigo_generacion

    , dt.tipo_dte

    , pe.id_pedido

    , cl.nombre cliente

    , dt.fecha_emision

    , dt.subtotal

    , dt.descuento

    , dt.iva

    , dt.retencion

    , dt.total_pagar

    , dt.estado_mh

    , dt.sello_recepcion

