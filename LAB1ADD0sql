-- Departamentos de El Salvador
CREATE TABLE catalogos.departamento
(
      id_departamento SERIAL PRIMARY KEY

    , nombre VARCHAR(100) NOT NULL UNIQUE
);

COMMENT ON TABLE catalogos.departamento
IS 'Catálogo de departamentos de El Salvador';


-- Municipios relacionados con un departamento
CREATE TABLE catalogos.municipio
(
      id_municipio SERIAL PRIMARY KEY

    , nombre VARCHAR(100) NOT NULL

    , id_departamento INT NOT NULL

    , FOREIGN KEY(id_departamento)
      REFERENCES catalogos.departamento(id_departamento)

    , UNIQUE(nombre, id_departamento)
);

COMMENT ON TABLE catalogos.municipio
IS 'Municipios pertenecientes a un departamento';


-- Comercios registrados en Sivar Express
CREATE TABLE catalogos.comercio
(
      id_comercio SERIAL PRIMARY KEY

    , nombre VARCHAR(150) NOT NULL

    , nit VARCHAR(17) NOT NULL UNIQUE

    , correo VARCHAR(100)

    , telefono VARCHAR(20)

    , direccion VARCHAR(250)
);

COMMENT ON TABLE catalogos.comercio
IS 'Comercios registrados en Sivar Express';


-- Consumidores finales y empresas
CREATE TABLE catalogos.cliente
(
      id_cliente SERIAL PRIMARY KEY

    , tipo_cliente VARCHAR(20) NOT NULL
      CHECK
      (
          tipo_cliente IN
          (
              'Consumidor Final'
            , 'Empresa'
          )
      )

    , nombre VARCHAR(150) NOT NULL

    , dui VARCHAR(10) UNIQUE

    , nit VARCHAR(17) UNIQUE

    , nrc VARCHAR(20) UNIQUE

    , giro VARCHAR(150)

    , telefono VARCHAR(20)

    , correo VARCHAR(100)

    , direccion VARCHAR(250)

    , id_municipio INT NOT NULL

    , FOREIGN KEY(id_municipio)
      REFERENCES catalogos.municipio(id_municipio)

    -- El consumidor final debe tener DUI
    -- y la empresa debe tener NIT, NRC y giro
    , CHECK
      (
          (
              tipo_cliente = 'Consumidor Final'
              AND dui IS NOT NULL
              AND nit IS NULL
              AND nrc IS NULL
              AND giro IS NULL
          )

          OR

          (
              tipo_cliente = 'Empresa'
              AND nit IS NOT NULL
              AND nrc IS NOT NULL
              AND giro IS NOT NULL
          )
      )
);

COMMENT ON TABLE catalogos.cliente
IS 'Clientes consumidores finales y empresas';


-- Cada producto pertenece a un comercio
CREATE TABLE catalogos.producto
(
      id_producto VARCHAR(10) PRIMARY KEY

    , id_comercio INT NOT NULL

    , nombre VARCHAR(120) NOT NULL

    , precio_actual NUMERIC(10,2) NOT NULL
      CHECK(precio_actual >= 0)

    , descripcion VARCHAR(250)

    , activo BOOLEAN NOT NULL DEFAULT TRUE

    , FOREIGN KEY(id_comercio)
      REFERENCES catalogos.comercio(id_comercio)
);

COMMENT ON TABLE catalogos.producto
IS 'Productos ofrecidos por los diferentes comercios';


