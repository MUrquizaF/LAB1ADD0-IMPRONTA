-- 3. INVENTARIO MULTIBODEGA
-- =====================================================


-- Bodegas donde se almacena el inventario
CREATE TABLE inventario.bodega
(
      id_bodega SERIAL PRIMARY KEY

    , nombre VARCHAR(100) NOT NULL UNIQUE

    , direccion VARCHAR(200) NOT NULL
);

COMMENT ON TABLE inventario.bodega
IS 'Bodegas físicas donde se almacenan los productos';


-- Relación N:M entre producto y bodega
CREATE TABLE inventario.inventario_bodega
(
      id_producto VARCHAR(10) NOT NULL

    , id_bodega INT NOT NULL

    , stock_actual INT NOT NULL
      CHECK(stock_actual >= 0)

    , stock_minimo INT NOT NULL DEFAULT 0
      CHECK(stock_minimo >= 0)

    , PRIMARY KEY(id_producto, id_bodega)

    , FOREIGN KEY(id_producto)
      REFERENCES catalogos.producto(id_producto)

    , FOREIGN KEY(id_bodega)
      REFERENCES inventario.bodega(id_bodega)
);

COMMENT ON TABLE inventario.inventario_bodega
IS 'Existencia de cada producto según la bodega';


-- =====================================================
-- 4. PEDIDOS Y DETALLE DE PEDIDOS
-- =====================================================


-- Cabecera del pedido
CREATE TABLE ventas.pedido
(
      id_pedido BIGINT GENERATED ALWAYS AS IDENTITY
      PRIMARY KEY

    , id_cliente INT NOT NULL

    , fecha_hora TIMESTAMP NOT NULL
      DEFAULT CURRENT_TIMESTAMP

    , costo_envio NUMERIC(10,2) NOT NULL
      DEFAULT 0
      CHECK(costo_envio >= 0)

    , metodo_pago VARCHAR(30) NOT NULL
      CHECK
      (
          metodo_pago IN
          (
              'Efectivo'
            , 'Tarjeta de Crédito'
            , 'Tarjeta de Débito'
            , 'Transferencia'
          )
      )

    , estado_actual VARCHAR(30) NOT NULL
      CHECK
      (
          estado_actual IN
          (
              'Creado'
            , 'Pago_Aprobado'
            , 'En_Preparación'
            , 'Despachado'
            , 'Entregado'
            , 'Cancelado'
          )
      )

    , FOREIGN KEY(id_cliente)
      REFERENCES catalogos.cliente(id_cliente)
);

COMMENT ON TABLE ventas.pedido
IS 'Pedidos realizados por los clientes';


-- Productos incluidos en cada pedido
CREATE TABLE ventas.detalle_pedido
(
      id_detalle BIGINT GENERATED ALWAYS AS IDENTITY
      PRIMARY KEY

    , id_pedido BIGINT NOT NULL

    , id_producto VARCHAR(10) NOT NULL

    , cantidad INT NOT NULL
      CHECK(cantidad > 0)

    , precio_unitario_historico NUMERIC(10,2) NOT NULL
      CHECK(precio_unitario_historico >= 0)

    , FOREIGN KEY(id_pedido)
      REFERENCES ventas.pedido(id_pedido)
      ON DELETE CASCADE

    , FOREIGN KEY(id_producto)
      REFERENCES catalogos.producto(id_producto)

    , UNIQUE(id_pedido, id_producto)
);

COMMENT ON TABLE ventas.detalle_pedido
IS 'Productos vendidos y precio registrado al momento de la compra';


-- =====================================================
-- 5. CUPONES Y DESCUENTOS
-- =====================================================


-- Cupones disponibles
CREATE TABLE ventas.cupon
(
      id_cupon SERIAL PRIMARY KEY

    , codigo VARCHAR(30) NOT NULL UNIQUE

    , tipo_descuento VARCHAR(20) NOT NULL
      CHECK
      (
          tipo_descuento IN
          (
              'MONTO'
            , 'PORCENTAJE'
          )
      )

    , valor NUMERIC(10,2) NOT NULL
      CHECK(valor > 0)

    , fecha_inicio DATE NOT NULL

    , fecha_fin DATE NOT NULL

    , monto_minimo_compra NUMERIC(10,2) NOT NULL
      DEFAULT 0
      CHECK(monto_minimo_compra >= 0)

    , limite_usos_global INT
      CHECK(limite_usos_global > 0)

    , CHECK(fecha_fin >= fecha_inicio)
);

COMMENT ON TABLE ventas.cupon
IS 'Cupones de monto fijo o porcentaje disponibles para los pedidos';


-- Relación entre pedido y cupón aplicado
CREATE TABLE ventas.pedido_cupon
(
      id_pedido BIGINT NOT NULL

    , id_cupon INT NOT NULL

    , monto_descontado NUMERIC(10,2) NOT NULL
      CHECK(monto_descontado >= 0)

    , fecha_aplicacion TIMESTAMP NOT NULL
      DEFAULT CURRENT_TIMESTAMP

    , PRIMARY KEY(id_pedido, id_cupon)

    , FOREIGN KEY(id_pedido)
      REFERENCES ventas.pedido(id_pedido)
      ON DELETE CASCADE

    , FOREIGN KEY(id_cupon)
      REFERENCES ventas.cupon(id_cupon)
);

COMMENT ON TABLE ventas.pedido_cupon
IS 'Trazabilidad de cupones aplicados a los pedidos';


-- =====================================================
-- 6. AUDITORÍA DE ESTADOS
-- =====================================================


-- Historial de cambios de estado del pedido
CREATE TABLE ventas.historial_estado
(
      id_historial SERIAL PRIMARY KEY

    , id_pedido BIGINT NOT NULL

    , estado VARCHAR(30) NOT NULL
      CHECK
      (
          estado IN
          (
              'Creado'
            , 'Pago_Aprobado'
            , 'En_Preparación'
            , 'Despachado'
            , 'Entregado'
            , 'Cancelado'
          )
      )

    , fecha_hora TIMESTAMP NOT NULL
      DEFAULT CURRENT_TIMESTAMP

    , usuario_responsable VARCHAR(100) NOT NULL

    , FOREIGN KEY(id_pedido)
      REFERENCES ventas.pedido(id_pedido)
      ON DELETE CASCADE
);

COMMENT ON TABLE ventas.historial_estado
IS 'Historial de estados y usuario responsable del cambio';


-- =====================================================
-- 7. FACTURACIÓN ELECTRÓNICA DTE
-- =====================================================


-- Documento Tributario Electrónico del pedido
CREATE TABLE facturacion.dte
(
      id_dte BIGINT GENERATED ALWAYS AS IDENTITY
      PRIMARY KEY

    , id_pedido BIGINT NOT NULL UNIQUE

    , tipo_dte VARCHAR(2) NOT NULL
      CHECK(tipo_dte IN ('01', '03'))

    , codigo_generacion UUID NOT NULL
      DEFAULT gen_random_uuid()
      UNIQUE

    , numero_control VARCHAR(50) NOT NULL UNIQUE

    , fecha_emision TIMESTAMP NOT NULL
      DEFAULT CURRENT_TIMESTAMP

    , subtotal NUMERIC(10,2) NOT NULL
      CHECK(subtotal >= 0)

    , descuento NUMERIC(10,2) NOT NULL
      DEFAULT 0
      CHECK(descuento >= 0)

    , iva NUMERIC(10,2) NOT NULL
      CHECK(iva >= 0)

    , retencion NUMERIC(10,2) NOT NULL
      DEFAULT 0
      CHECK(retencion >= 0)

    , total_pagar NUMERIC(10,2) NOT NULL
      CHECK(total_pagar >= 0)

    , estado_mh VARCHAR(20) NOT NULL
      CHECK
      (
          estado_mh IN
          (
              'PROCESADO'
            , 'RECHAZADO'
            , 'INVALIDADO'
          )
      )

    , sello_recepcion CHAR(40)

    , FOREIGN KEY(id_pedido)
      REFERENCES ventas.pedido(id_pedido)
      ON DELETE CASCADE
);

COMMENT ON TABLE facturacion.dte
IS 'Documento Tributario Electrónico enviado al Ministerio de Hacienda';


