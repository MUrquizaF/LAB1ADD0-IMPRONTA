FROM ventas.pedido pe
    , ventas.detalle_pedido dp
    , catalogos.producto pr
    , catalogos.comercio co

WHERE pe.id_pedido = dp.id_pedido
AND dp.id_producto = pr.id_producto
AND pr.id_comercio = co.id_comercio

ORDER BY co.nombre
       , pr.nombre;


